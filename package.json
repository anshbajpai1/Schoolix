{
  "name": "schoolix",
  "version": "1.0.0",
  "description": "School management system",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:hosting": "node scripts/build-mobile.mjs --web-loader --out=hosting",
    "test:session-sync": "node --experimental-vm-modules scripts/verify-session-sync.mjs",
    "migrate:firestore": "node scripts/migrate-firestore-to-supabase.mjs",
    "migrate:auth": "node scripts/migrate-firebase-auth-to-supabase.mjs",
    "android:sync": "npm run build:mobile -- --skip-apk && npx cap sync android",
    "android:open": "npx cap open android",
    "notify:update": "node scripts/send-update-notification.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^8.3.4",
    "@supabase/supabase-js": "^2.109.0",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0"
  }
}
