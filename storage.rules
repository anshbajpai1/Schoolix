rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "superAdmin"
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.superAdmin == true
        );
    }

    match /app-updates/latest/{apkFile} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && request.resource.size <= 120 * 1024 * 1024
        && request.resource.contentType == "application/vnd.android.package-archive"
        && apkFile.matches(".*\\.apk$");
    }
  }
}
