# Android build configuration. The generated google-services.json remains
# ignored; restrict this Firebase key to the Android package and signing SHA.
SCHOOLIX_ANDROID_FIREBASE_API_KEY=replace_with_android_firebase_api_key

# Server-only values for the Netlify gateway. Configure these in Netlify
# environment variables and never commit the real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_in_netlify_only

# Additional server-only examples.
# SUPABASE_SERVICE_ROLE_KEY=replace_on_server_only
# FIREBASE_PRIVATE_KEY=replace_on_server_only
# OPENAI_API_KEY=replace_on_server_only
# GEMINI_API_KEY=replace_on_server_only
